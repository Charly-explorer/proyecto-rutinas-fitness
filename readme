  "descripcion": "Ejercicio de pecho con barra",
  "musculo_principal": "pecho",
  "musculos_secundarios": "triceps",
  "equipamiento": "barra",
  "nivel": "intermedio",
  "tipo": "fuerza",
  "repeticiones_sugeridas": 8,
  "series_sugeridas": 3,
  "peso_sugerido": 50,
  "riesgos": "Lesión de hombro"
}

Actualizar Ejercicio (Admin)
PUT /api/ejercicios/{id}
Authorization: Bearer <token>
Content-Type: application/json

{
  "nombre": "Press de Banca Actualizado"
}

Eliminar Ejercicio (Admin)
DELETE /api/ejercicios/{id}
Authorization: Bearer <token>

Obtener Todas las Rutinas
