  "usuario_id": 1,
  "rutina_id": 3,
  "fecha_asignacion": "2024-01-15",
  "activa": true
}

Activar Rutina
PUT /api/usuario-rutinas/{id}/activar
Authorization: Bearer <token>
Content-Type: application/json

{
  "usuario_id": 1
}


Obtener Progreso del Usuario
