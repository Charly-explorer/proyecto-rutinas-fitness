  "rutina_id": 3,
  "ejercicio_id": 5,
  "series_completadas": 3,
  "repeticiones_completadas": 8,
  "peso_usado_kg": 50,
  "notas": "Buena sesión"
}


 Autenticación
Flujo de Autenticación
Login → Recibe token JWT
Almacenar → Guardar token en localStorage o variable
Usar → Enviar en header Authorization: Bearer <token>
Token JWT
El token contiene:

{
  "id": 1,
  "email": "usuario@example.com",
  "rol": "admin",
  "iat": 1705699200,
  "exp": 1705702800
}


Roles y Permisos
Rol	Permisos
admin	Crear/actualizar/eliminar ejercicios, ver todos los usuarios, gestionar roles
usuario	Ver/actualizar su perfil, ver sus rutinas, registrar progreso


Base de Datos
Esquema Relacional
-- Usuarios
CREATE TABLE usuarios (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  email VARCHAR(100) UNIQUE NOT NULL,
  password_hash VARCHAR(255) NOT NULL,
  edad INT,
  estatura_cm INT,
  peso_kg DECIMAL(5,2),
  nivel_actividad VARCHAR(50),
  objetivo VARCHAR(100),
  rol ENUM('admin', 'usuario') DEFAULT 'usuario',
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Ejercicios
CREATE TABLE ejercicios (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  descripcion TEXT,
  musculo_principal VARCHAR(50),
  musculos_secundarios VARCHAR(100),
  equipamiento VARCHAR(100),
  nivel VARCHAR(50),
  tipo VARCHAR(50),
  repeticiones_sugeridas INT,
  series_sugeridas INT,
  peso_sugerido DECIMAL(5,2),
  riesgos TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Rutinas
CREATE TABLE rutinas (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  descripcion TEXT,
  objetivo VARCHAR(100),
  nivel VARCHAR(50),
  dias_por_semana INT,
  tipo VARCHAR(50),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Rutina-Ejercicios
CREATE TABLE rutina_ejercicios (
  id INT PRIMARY KEY AUTO_INCREMENT,
  rutina_id INT NOT NULL,
  ejercicio_id INT NOT NULL,
  dia_semana VARCHAR(20),
  orden INT,
  FOREIGN KEY (rutina_id) REFERENCES rutinas(id) ON DELETE CASCADE,
  FOREIGN KEY (ejercicio_id) REFERENCES ejercicios(id) ON DELETE CASCADE
);

-- Usuario-Rutinas
CREATE TABLE usuario_rutinas (
  id INT PRIMARY KEY AUTO_INCREMENT,
  usuario_id INT NOT NULL,
  rutina_id INT NOT NULL,
  fecha_asignacion DATE,
  activa BOOLEAN DEFAULT FALSE,
  FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
  FOREIGN KEY (rutina_id) REFERENCES rutinas(id) ON DELETE CASCADE
);

-- Progreso Usuarios
CREATE TABLE progreso_usuarios (
  id INT PRIMARY KEY AUTO_INCREMENT,
  usuario_id INT NOT NULL,
  rutina_id INT,
  ejercicio_id INT,
  fecha DATE NOT NULL,
  peso_kg DECIMAL(5,2),
  series_completadas INT,
  repeticiones_completadas INT,
  peso_usado_kg DECIMAL(5,2),
  notas TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
  FOREIGN KEY (rutina_id) REFERENCES rutinas(id),
  FOREIGN KEY (ejercicio_id) REFERENCES ejercicios(id)
);

Solución de Problemas
El servidor no abre el puerto
# Buscar proceso usando puerto 4000
netstat -ano | findstr :4000

# Matar el proceso (Windows)
taskkill /PID <PID> /F

# O cambiar puerto en .env
PORT=5000


No se genera el token en login
Problema: Token no aparece en respuesta

Soluciones:

Verificar que JWT_SECRET esté en .env
Revisar que usuariosService.getByEmail() exista
Validar credenciales en BD (usuario y contraseña)

# En la consola del servidor
console.log('Token generado:', token);



Ejemplo: Flujo Completo de Login
# 1. Crear usuario
curl -X POST http://localhost:4000/api/usuarios \
  -H "Content-Type: application/json" \
  -d '{
    "nombre": "Juan",
    "email": "juan@test.com",
    "password": "12345678",
    "rol": "usuario"
  }'

# 2. Hacer login
curl -X POST http://localhost:4000/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{
    "email": "juan@test.com",
    "password": "12345678"
  }'

# Copia el token de la respuesta

# 3. Usar token para acceder a rutas protegidas
curl -X GET http://localhost:4000/api/usuarios/1 \
  -H "Authorization: Bearer <TOKEN_AQUI>"